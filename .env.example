# Telegram bot token from @BotFather
BOT_TOKEN=

# Free Google AI Studio API key from https://aistudio.google.com
GEMINI_API_KEY=

# Optional: model name (defaults to gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Your Telegram user ID — REQUIRED for agent system tools (shell, files, apps).
# Find it by sending /id to the bot. Without it, system control stays disabled.
OWNER_ID=

# Agent behavior
AGENT_ENABLED=true
AGENT_TIMEOUT=120000
BROWSER_TIMEOUT=30000
MAX_AGENT_ROUNDS=5

# Telegram Mini App (web app / visual mode)
# The bot serves a web UI on http://localhost:8834.
# Telegram Desktop can open http://localhost Mini Apps; mobile needs an HTTPS
# URL (e.g. `cloudflared tunnel --url http://localhost:8834`) set via WEBAPP_URL.
WEBAPP_ENABLED=true
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8834
# WEBAPP_URL=https://your-domain.example
# DEV ONLY: allow opening the web UI in a plain browser without Telegram init data.
WEBAPP_ALLOW_INSECURE=false
