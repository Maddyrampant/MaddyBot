# Telegram bot token from @BotFather
BOT_TOKEN=

# Free Google AI Studio API key from https://aistudio.google.com
GEMINI_API_KEY=

# Optional: model name (defaults to gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Image generation/editing model (used by /imagine, /edit, /style, ...)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Text-to-speech model and voice (used by /speak and voice replies)
# Free-tier TTS is rate-limited, so voices are cached on disk after first use.
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore

# Your Telegram user ID — REQUIRED for agent system tools (shell, files, apps).
# Find it by sending /id to the bot. Without it, system control stays disabled.
OWNER_ID=

# Agent behavior
AGENT_ENABLED=true
AGENT_TIMEOUT=120000
BROWSER_TIMEOUT=30000
MAX_AGENT_ROUNDS=5

# Telegram Mini App (web app / visual mode)
# The bot serves a web UI on http://localhost:8834.
# Telegram Desktop can open http://localhost Mini Apps; mobile needs an HTTPS
# URL (e.g. `cloudflared tunnel --url http://localhost:8834`) set via WEBAPP_URL.
WEBAPP_ENABLED=true
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8834
# WEBAPP_URL=https://your-domain.example
# DEV ONLY: allow opening the web UI in a plain browser without Telegram init data.
WEBAPP_ALLOW_INSECURE=false

# Incoming webhook: lets external services (n8n, Zapier, curl, ...) push a
# message to any chat via POST http://localhost:8834/api/webhook
# with header `X-Webhook-Token: <WEBHOOK_TOKEN>` and body { "chatId": 123, "text": "..." }
WEBHOOK_ENABLED=false
WEBHOOK_TOKEN=

# Optional: Redis URL for pushing generated voice messages to a phone app.
# The last 20 voices are kept in the list `maddy:voice`, each entry is JSON:
# { at, text, mime, ext, data } where `data` is the audio bytes as base64.
# Leave empty to disable (voices are then only sent inside Telegram).
# REDIS_URL=redis://default:password@localhost:6379

# Local AI (Ollama) — free, runs on your own machine.
# Start the daemon: `ollama serve` (models on E:\ollama-models), then e.g. `ollama pull qwen3:8b`.
# AI_MODE: auto = use Gemini, fall back to Ollama when no GEMINI_API_KEY;
#          ollama = always use the local model; gemini = never use local.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
AI_MODE=auto

# Local Stable Diffusion (Forge) image generation.
# Launch: E:\AI-Studio\start-forge.bat  (serves the /sdapi API on port 7861)
# When enabled, /imagine uses your local SD model instead of Gemini.
LOCAL_IMAGE_ENABLED=false
LOCAL_IMAGE_URL=http://127.0.0.1:7861
LOCAL_IMAGE_STEPS=25
