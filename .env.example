# Telegram bot token from @BotFather
BOT_TOKEN=

# Free Google AI Studio API key from https://aistudio.google.com
GEMINI_API_KEY=

# Optional: model name (defaults to gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Your Telegram user ID — REQUIRED for agent system tools (shell, files, apps).
# Find it by sending /id to the bot. Without it, system control stays disabled.
OWNER_ID=

# Agent behavior
AGENT_ENABLED=true
AGENT_TIMEOUT=120000
BROWSER_TIMEOUT=30000
MAX_AGENT_ROUNDS=5
